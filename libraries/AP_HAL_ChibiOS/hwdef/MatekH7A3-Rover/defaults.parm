# Rover default parameters for MatekH7A3 (mirrors MatekH743-Rover, adapted
# to the H7A3's 6 UARTs and 11 PWM outputs)

# Carried over from the stock MatekH7A3 defaults.parm (the parent board's
# defaults file is NOT inherited through hwdef include)
CAN_D1_PROTOCOL 1
CAN_P1_DRIVER   1

# Arming: all checks disabled, arm/disarm on RC channel 6
ARMING_CHECK 0
RC6_OPTION 153

# Battery monitor 1 disabled, battery on monitor 2
BATT_MONITOR 0
BATT2_MONITOR 4
BATT2_CAPACITY 60000
BATT2_VOLT_MULT 21

# Serial ports (H7A3: SERIAL1..6 only)
# SERIAL1 USART1 (DMA), SERIAL2 USART2 (DMA), SERIAL3 USART3 (DMA),
# SERIAL4 UART4 (no DMA), SERIAL5 UART5 (no DMA), SERIAL6 USART6 (no DMA)
SERIAL1_PROTOCOL 2
SERIAL1_BAUD 115
SERIAL2_PROTOCOL 2
SERIAL2_BAUD 115
SERIAL3_PROTOCOL 5
SERIAL3_BAUD 230
SERIAL4_PROTOCOL 23
SERIAL4_BAUD 115
SERIAL5_PROTOCOL -1
SERIAL5_BAUD 57
SERIAL6_PROTOCOL -1
SERIAL6_BAUD 57

# Servo outputs: skid steering + RC passthrough on 2/4
SERVO1_FUNCTION 73
SERVO1_MIN 988
SERVO1_TRIM 1500
SERVO1_MAX 2100
SERVO2_FUNCTION 63
SERVO2_MIN 1100
SERVO2_TRIM 1500
SERVO2_MAX 1900
SERVO3_FUNCTION 74
SERVO3_MIN 988
SERVO3_TRIM 1500
SERVO3_MAX 2100
SERVO4_FUNCTION 62
SERVO4_MIN 1100
SERVO4_TRIM 1500
SERVO4_MAX 1900
SERVO5_FUNCTION 0
SERVO6_FUNCTION 0
SERVO7_FUNCTION 0
SERVO8_FUNCTION 0
SERVO9_FUNCTION 0
SERVO10_FUNCTION 0
SERVO11_FUNCTION 0
SERVO12_FUNCTION 0
SERVO13_FUNCTION 0
SERVO14_FUNCTION 0
SERVO15_FUNCTION 0
SERVO16_FUNCTION 0
